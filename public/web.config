<?xml version="1.0"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="App Routes Remove Slash" stopProcessing="true">
          <match url="^((seslendirme|desifre|fiyatlar|kurumsal|api-dokumantasyon|iletisim|giris|profile|admin|checkout|payment/(success|fail)))/$" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Prerendered App Routes" stopProcessing="true">
          <match url="^(seslendirme|desifre|fiyatlar|kurumsal|api-dokumantasyon|iletisim|giris|profile|admin|checkout|payment/(success|fail))$" />
          <action type="Rewrite" url="/{R:0}/index.html" />
        </rule>
        <rule name="Legal Pages Canonical Slash" stopProcessing="true">
          <match url="^(gizlilik-politikasi|kullanim-kosullari|kvkk-aydinlatma-metni|cerez-politikasi)$" />
          <action type="Redirect" url="/{R:0}/" redirectType="Permanent" />
        </rule>
        <rule name="SEO Content Canonical Slash" stopProcessing="true">
          <match url="^(rehber|cozumler)(/[^/]+)?$" />
          <action type="Redirect" url="/{R:0}/" redirectType="Permanent" />
        </rule>
        <rule name="Unknown SEO Content" stopProcessing="true">
          <match url="^(rehber|cozumler)/.+" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Page not found" />
        </rule>
        <rule name="Unknown Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Page not found" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
