{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-app.mjs",
    "deploy:manifest": "node scripts/generate-deployment-manifest.mjs",
    "lint": "eslint .",
    "test": "npm run test:asr && npm run test:i18n && npm run test:seo && node tests/pricing-removed.test.mjs && node tests/service-status.test.mjs && node tests/api-docs-content.test.mjs",
    "test:asr": "node tests/unified-asr.test.mjs && node tests/asr-realtime-contract.test.mjs",
    "test:i18n": "node scripts/check-i18n.mjs",
    "test:seo": "node scripts/verify-seo.mjs",
    "test:seo:production": "playwright test --config playwright.production.config.js",
    "seo:keywords": "node scripts/generate-keyword-registry.mjs",
    "test:i18n:e2e": "playwright test tests/i18n-toggle.spec.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "motion": "^13.3.0",
    "ogl": "^1.0.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
