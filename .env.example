# Optional local HTTPS certificate paths for Vite development.
# Keep certificate and private key files outside the repository.
# API origin only. The frontend appends /api/v1/... to this value.
VITE_API_BASE_URL=https://api.konusmatik.com
VITE_SITE_URL=https://konusmatik.com
VITE_DEV_CERT_PATH=
VITE_DEV_KEY_PATH=

# Public OAuth client ID only. Never put a client secret in Vite variables.
VITE_GOOGLE_CLIENT_ID=
# Keep disabled until the verified backend exchange and legal onboarding exist.
# Endpoints must be same-origin /api/v1/... paths supplied by the backend owner.
VITE_GOOGLE_AUTH_ENABLED=false
VITE_GOOGLE_AUTH_ENDPOINT=
VITE_GOOGLE_ONBOARDING_ENDPOINT=
# Approved Terms version assigned by the company/legal team; never invent a date.
VITE_TERMS_VERSION=
# Existing email registration payload is unchanged until the backend accepts consent fields.
VITE_EMAIL_CONSENT_ENABLED=false
# New-account registration is closed in production until approved Terms and
# backend storage of the Terms version and marketing preference are confirmed.
VITE_EMAIL_REGISTRATION_ENABLED=false

# Production payment is disabled by default. Development keeps the existing test flow.
# Enable only after approved seller details, pre-contract notice, distance-sales terms,
# tax-inclusive prices, renewal and withdrawal/refund policy are implemented and tested.
VITE_CHECKOUT_PAYMENT_ENABLED=false

# Increment this when a material consent policy/provider change requires a new choice.
VITE_COOKIE_CONSENT_VERSION=1
# Optional re-prompt interval in days; 0 means no automatic time-based expiry.
VITE_COOKIE_CONSENT_RENEW_DAYS=0
